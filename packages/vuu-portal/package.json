{
  "name": "@heswell/vuu-portal",
  "version": "1.0.0",
  "description": "VUU portal server with remote module discovery",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    }
  },
  "bin": {
    "vuu-portal": "./src/bin.ts"
  },
  "sideEffects": [
    "./src/bin.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "etsc",
    "build:vuu": "node ../../scripts/build.mjs"
  },
  "author": "heswell",
  "license": "MIT",
  "dependencies": {
    "@heswell/module-admin": "2.0.0",
    "@heswell/vuu-server": "3.0.0",
    "@heswell/vuu-table": "1.0.1",
    "pino": "9.6.0"
  }
}
