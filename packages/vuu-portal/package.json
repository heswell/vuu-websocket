{
  "name": "@heswell/vuu-portal",
  "version": "2.0.0",
  "description": "VUU portal server with remote module discovery",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    }
  },
  "typesVersions": {
    "*": {
      "main": [
        "./src/main.ts"
      ]
    }
  },
  "bin": {
    "vuu-portal": "./src/bin.ts"
  },
  "sideEffects": [
    "./src/bin.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && bun ./scripts/prepare-package.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "heswell",
  "license": "MIT",
  "dependencies": {
    "@heswell/module-admin": "2.0.0",
    "@heswell/vuu-server": "3.1.0",
    "@heswell/vuu-table": "1.0.1"
  },
  "peerDependencies": {
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.20"
  },
  "devDependencies": {
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.20"
  }
}
