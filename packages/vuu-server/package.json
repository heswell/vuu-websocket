{
  "name": "@heswell/vuu-server",
  "version": "4.2.2",
  "description": "Vuu view server for Bun: tables, viewports, modules, RPC and websocket/HTTP hosting",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && bun ./scripts/prepare-package.ts",
    "bench:outbound": "bun ./bench/outbound.bench.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "heswell",
  "license": "MIT",
  "dependencies": {
    "@heswell/service-utils": "^1.2.2",
    "@heswell/vuu-table": "^1.0.3",
    "@heswell/vuu-viewport": "^1.1.6"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0",
    "@vuu-ui/vuu-data-types": "^4.0.0-alpha.25",
    "@vuu-ui/vuu-protocol-types": "^4.0.0-alpha.25",
    "@vuu-ui/vuu-utils": "^4.0.0-alpha.25"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vuu-ui/vuu-data-types": "4.0.0-alpha.25",
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.25",
    "@vuu-ui/vuu-utils": "4.0.0-alpha.25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heswell/vuu-websocket.git",
    "directory": "packages/vuu-server"
  }
}
