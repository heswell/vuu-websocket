{
  "name": "@heswell/service-utils",
  "version": "1.1.0",
  "description": "Shared utilities for Vuu services: config loading, argument parsing, remote table publishing and subscription",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && bun ./scripts/prepare-package.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "heswell",
  "license": "MIT",
  "dependencies": {
    "@heswell/vuu-table": "^1.0.1"
  },
  "peerDependencies": {
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.20"
  },
  "devDependencies": {
    "@vuu-ui/vuu-protocol-types": "4.0.0-alpha.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heswell/vuu-websocket.git",
    "directory": "packages/service-utils"
  }
}
