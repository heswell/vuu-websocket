{
  "name": "@heswell/user-admin",
  "version": "1.0.0",
  "description": "Reusable VUU user-administration module",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "import": "./src/contracts/index.ts"
    },
    "./in-memory": {
      "types": "./src/in-memory/index.ts",
      "import": "./src/in-memory/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && bun ./scripts/prepare-package.ts"
  },
  "author": "heswell",
  "license": "MIT"
}
