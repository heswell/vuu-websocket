{
  "name": "@heswell/vuu-server-node",
  "version": "1.0.0",
  "description": "Node.js runtime for @heswell/vuu-server: HTTP and websocket servers (node:http, ws) and YAML",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && bun ./scripts/prepare-package.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "author": "heswell",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@heswell/vuu-server": "^4.5.0"
  },
  "devDependencies": {
    "@heswell/vuu-server": "^4.6.0",
    "@types/ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heswell/vuu-websocket.git",
    "directory": "packages/vuu-server-node"
  }
}
