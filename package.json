{
  "name": "vuu-websocket",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "build:packages": "bun ./scripts/build-packages.ts",
    "test:engine-packages": "bun ./scripts/smoke-test-engine-packages.ts",
    "perf": "bun ./scripts/perf.ts",
    "keycloak:realm": "bun ./scripts/keycloak-realm-client.ts",
    "keycloak:users": "bun ./scripts/keycloak-users.ts",
    "keycloak:bootstrap": "npm run keycloak:realm && npm run keycloak:users",
    "keycloak:clear-data": "bun ./scripts/clear-keycloak-data.ts",
    "start:all": "bun ./scripts/start-all.ts",
    "start": "WEBSOCKET_PORT=8090 npm start:all",
    "start:demo": "VUU_APP=vuu-demo WEBSOCKET_PORT=8090 bun ./scripts/start-demo.ts",
    "start:portal": "VUU_APP=vuu-portal bun ./scripts/start-portal.ts",
    "start:portal:all": "bun ./scripts/start-portal-all.ts",
    "start:user-admin": "VUU_APP=vuu-user-admin bun ./scripts/start-user-admin.ts",
    "start:basket-trading": "VUU_APP=vuu-basket-trading bun ./scripts/start-basket-trading.ts",
    "start:demo:2": "VUU_APP=vuu-demo WEBSOCKET_PORT=8095 bun ./scripts/start-demo.ts",
    "debug:demo": "VUU_APP=vuu-demo WEBSOCKET_PORT=8090 bun --inspect ./scripts/start-demo.ts",
    "start:orders": "bun ./scripts/start-orders.ts",
    "start:prices": "bun ./scripts/start-prices.ts",
    "start:refdata": "bun ./scripts/start-refdata.ts",
    "start:equities": "bun ./scripts/start-equities.ts",
    "debug": "bun --inspect ./start.ts",
    "bench": "bun ./packages/benchmarks/src/run.ts",
    "bench:1m": "bun ./packages/benchmarks/src/run.ts --rows=1000000",
    "bench:scala": "bun ./packages/benchmarks/src/scala/run.ts",
    "bench:data-engine-local": "npm run bench -w @heswell/vuu-data-engine-local",
    "bench:data-engine-local:1m": "npm run bench:scale -w @heswell/vuu-data-engine-local",
    "test": "bun test",
    "bump:versions": "bun ./scripts/bump-versions.ts",
    "pub": "bun ./scripts/publish.ts",
    "release:vuu-ui": "bun ./scripts/release-vuu-ui.ts",
    "version-check": "bun ./scripts/version-check.ts",
    "typecheck": "tsc --noEmit --project tsconfig-typecheck.json",
    "typecheck:packages": "npm run typecheck -w @heswell/service-utils -w @heswell/vuu-server -w @heswell/vuu-portal"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@heswell/equity-refdata-service": "1.0.1",
    "@heswell/orders-service": "1.0.1",
    "@heswell/price-service": "1.0.1",
    "@heswell/reference-data-service": "1.0.1",
    "@heswell/vuu-basket-trading": "1.0.1",
    "@heswell/vuu-demo": "3.0.1",
    "@heswell/vuu-portal": "2.4.0",
    "@heswell/vuu-table": "1.1.0",
    "@heswell/vuu-user-admin": "1.0.1",
    "@heswell/vuu-viewport": "1.2.0",
    "@microsoft/api-extractor": "7.59.1",
    "@rslib/core": "0.23.1",
    "@types/bun": "1.3.3",
    "@vuu-ui/vuu-protocol-types": "5.0.0-alpha.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@vuu-ui/vuu-utils": "5.0.0-alpha.2",
    "pure-uuid": "^1.8.1"
  }
}
